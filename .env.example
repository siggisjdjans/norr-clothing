# ── Stripe ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ── Site URL ────────────────────────────────────────────────────────────
# Set to your production URL on Render (e.g. https://norr-clothing.onrender.com)
# Leave as http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: publishable key (only needed for Stripe.js client-side flows;
# this project uses Stripe Checkout, so it's not required) ──────────────
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_publishable_key_here
